**/build/

# Flutter tool generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Dart generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter/Dart coverage
coverage/

# Android specific
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/*.keystore
**/*.jks

