# =============================================================================
# Smart Livestock Health and Farm Management System — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS — Never commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
service-account*.json
# google-services.json  # Uncomment when Firebase is added (Phase 4)

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
!mobile/livestock_app/lib/
*.manifest
*.spec

# Virtual environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
*.sqlite3
local_settings.py
media/
staticfiles/
static_root/

# -----------------------------------------------------------------------------
