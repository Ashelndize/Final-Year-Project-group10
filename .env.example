# =============================================================================
# Smart Livestock Health and Farm Management System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is gitignored.
# This file (.env.example) is safe to commit — it contains no real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=livestock_db
DB_USER=livestock_user
DB_PASSWORD=your-db-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# -----------------------------------------------------------------------------
# JWT authentication (djangorestframework-simplejwt)
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------------------------------------------------------
# AI Assistant (Phase 6)
# ASSISTANT_PROVIDER options: kb_only | openai | anthropic
# Set ASSISTANT_ENABLED=True to activate the assistant endpoints.
# -----------------------------------------------------------------------------
ASSISTANT_ENABLED=False
ASSISTANT_PROVIDER=kb_only

# -----------------------------------------------------------------------------
# Email (Phase 2 — password reset)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@livestock.local

# -----------------------------------------------------------------------------
# CORS (Phase 2 onwards — add frontend origins as needed)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Security (production only — uncomment and set after HTTPS is confirmed)
# Do NOT enable these in development; they will break the local server.
# -----------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-server-hostname.com,www.your-server-hostname.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
